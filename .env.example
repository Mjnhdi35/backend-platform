# Copy to .env and adjust: cp .env.example .env
# .env is read by both the Nest app (@nestjs/config) and docker compose.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (used by the Nest app / TypeORM) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app
DB_PASSWORD=app
DB_DATABASE=app

# --- Docker compose (MySQL + Adminer containers) ---
# Keep MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE / MYSQL_PORT in sync with the DB_* values above.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_PORT=3306
ADMINER_PORT=8080
